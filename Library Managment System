import java.io.File;
import java.io.FileNotFoundException;
import java.util.ArrayList;
import java.util.Scanner;

public class Main {
    static ArrayList<String> users = new ArrayList<>();

    public Main() {
    }
    /* *
    * * Each line should be formatted as: * ID,Name,Address,Fine */
    public static void loadData(String fileName) {
        try {
            File file = new File(fileName);
            Scanner fileScanner = new Scanner(file);

            while(fileScanner.hasNextLine()) {
                users.add(fileScanner.nextLine());
            }

            fileScanner.close();
            System.out.println("\nData loaded successfully.");
        } catch (FileNotFoundException var3) {
            System.out.println("\nError: File not found.");
        }

    }

    public static void printUsers() {
        System.out.println("\n===== USER LIST =====");
        if (users.isEmpty()) {
            System.out.println("No user found.");
        } else {
            for(String user : users) {
                System.out.println(user);
            }

        }
    }
    /* * Checks if a user ID already exists.
    *  * Returns true if a duplicate is found. */
    public static boolean duplicateID(String id) {
        for(String users : Main.users) {
            String[] data = users.split(",");
            if (data[0].equals(id)) {
                return true;
            }
        }

        return false;
    }

    public static void addUser(Scanner input) {
        System.out.print("Enter 7-digit ID: ");
        String id = input.nextLine();
        if (id.length() != 7) {
            System.out.println("Error: ID must be exactly 7 digits.");
        } else if (duplicateID(id)) {
            System.out.println("Error: Duplicate ID not allowed.");
        } else {
            System.out.print("Enter Name: ");
            String name = input.nextLine();
            System.out.print("Enter Address: ");
            String address = input.nextLine();
            System.out.print("Enter Fine Amount: ");
            String fine = input.nextLine();
            users.add(id + "," + name + "," + address + "," + fine);
            System.out.println("\nUser added successfully.");
            printUsers();
        }
    }

    public static void removeUser(Scanner input) {
        System.out.print("Enter User ID to remove: ");
        String id = input.nextLine();

        for(int i = 0; i < users.size(); ++i) {
            String[] data = ((String)users.get(i)).split(",");
            if (data[0].equals(id)) {
                users.remove(i);
                System.out.println("\nUser removed successfully.");
                printUsers();
                return;
            }
        }

        System.out.println("User not found.");
    }

    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        System.out.print("Enter text file location: ");
        String fileName = input.nextLine();
        loadData(fileName);
        printUsers();

        int choice;
        do {
            System.out.println("\n===== LIBRARY MENU =====");
            System.out.println("1. Add User");
            System.out.println("2. Remove User");
            System.out.println("3. Print All Users");
            System.out.println("4. Exit");
            System.out.print("Select an option: ");

            while(!input.hasNextInt()) {
                System.out.println("Please enter a number.");
                input.next();
            }

            choice = input.nextInt();
            input.nextLine();
            switch (choice) {
                case 1:
                    addUser(input);
                    break;
                case 2:
                    removeUser(input);
                    break;
                case 3:
                    printUsers();
                    break;
                case 4:
                    System.out.println("\nProgram terminated.");
                    break;
                default:
                    System.out.println("Invalid option.");
            }
        } while(choice != 4);

        input.close();
    }
}
